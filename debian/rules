#!/usr/bin/make -f
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 The Blueberry Pie OS Authors

include /usr/share/pietoolchain/rules.mk

C_SRCS   := getmntopts.c humanize_number.c pidfile.c expand_number.c realhostname.c \
	reexec_to_match_kernel.c trimdomain.c tzlink.c
CXX_SRCS := ExtentManager.cpp wipefs.cpp
OBJS     := $(patsubst %,$(OBJ)/%.o,$(basename $(C_SRCS) $(CXX_SRCS)))
DYLIB    := $(OBJ)/libutil.dylib

FLAGS := $(BASE_CFLAGS) -Wall -I$(SRCROOT) -isystem $(SDK)/usr/local/include

all: $(DYLIB)

$(OBJ)/%.o: $(SRCROOT)/%.c
	@mkdir -p $(OBJ)
	$(CC) $(FLAGS) -c $< -o $@
$(OBJ)/%.o: $(SRCROOT)/%.cpp
	@mkdir -p $(OBJ)
	$(CXX) $(FLAGS) -std=gnu++17 -c $< -o $@

NOTICE := $(OBJ)/apsl-notice

$(NOTICE):
	@mkdir -p $(OBJ)
	printf '%s\n' 'This program contains Covered Code under the Apple Public Source License 2.0.' \
		'Its Source Code is available under that License from https://github.com/blueberrypieos/libutil.' > $@

$(DYLIB): $(OBJS) $(NOTICE)
	$(CXX) $(BASE_LDFLAGS) -dynamiclib -install_name /usr/lib/libutil.dylib \
		-compatibility_version 1 -current_version 1 \
		-Wl,-sectcreate,__TEXT,__source,$(NOTICE) \
		-Wl,-exported_symbols_list,$(SRCROOT)/debian/libutil.exports $(OBJS) -o $@

install: $(DYLIB) installhdrs
	install -d $(ROOT)/usr/lib
	install -m 755 $(DYLIB) $(ROOT)/usr/lib/

installhdrs:
	install -d $(ROOT)/usr/local/include
	install -m 644 $(addprefix $(SRCROOT)/,libutil.h mntopts.h tzlink.h wipefs.h) $(ROOT)/usr/local/include/

.PHONY: all install installhdrs
